    {
      "id": "lifecycle-sign-message-deterministic",
      "title": "signMessage produces base64 FAKE_TEST_SIGNATURE marker without private keys",
      "category": "message-signing",
      "provenance": {
        "generator": "UTF-8 base64 encoding of FAKE_TEST_SIGNATURE:<address>:<message>",
        "containsSecretMaterial": false,
        "identitiesUsed": ["account-zero-default"],
        "deterministicConstruction": "Base64 of 'FAKE_TEST_SIGNATURE:GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF:Verify dApp session nonce 42'."
      },
      "initialState": {
        "installed": true,
        "connected": true,
        "allowed": true,
        "address": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF",
        "network": "TESTNET",
        "networkPassphrase": "Test SDF Network ; September 2015"
      },
      "request": {
        "operation": "signMessage",
        "args": [
          "Verify dApp session nonce 42",
          {
            "networkPassphrase": "Test SDF Network ; September 2015"
          }
        ]
      },
      "expectedResult": {
        "signedMessage": "RkFLRV9URVNUX1NJR05BVFVSRTpHQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQVdIRjpWZXJpZnkgZEFwcCBzZXNzaW9uIG5vbmNlIDQy",
        "signerAddress": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF"
      },
      "decodedExpectations": {
        "decodedUtf8Payload": "FAKE_TEST_SIGNATURE:GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF:Verify dApp session nonce 42",
        "nonCryptographicTestMarker": true
      }
    },
    {
      "id": "lifecycle-sign-message-account-mismatch",
      "title": "signMessage rejects mismatched signer option with ACCOUNT_MISMATCH",
      "category": "error-signing-guard",
      "provenance": {
        "generator": "@stellar/stellar-sdk StrKey public-byte encoding",
        "containsSecretMaterial": false,
        "identitiesUsed": ["account-zero-default", "account-recipient-01"],
        "deterministicConstruction": "Active wallet is 0x00 account while caller requests signing as 0x01 account."
      },
      "initialState": {
        "installed": true,
        "connected": true,
        "allowed": true,
        "address": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF",
        "network": "TESTNET",
        "networkPassphrase": "Test SDF Network ; September 2015"
      },
      "request": {
        "operation": "signMessage",
        "args": [
          "Verify dApp session nonce 42",
          {
            "address": "GAAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQCAIBAEAQDZ7H",
            "networkPassphrase": "Test SDF Network ; September 2015"
          }
        ]
      },
      "expectedResult": {
        "signedMessage": "",
        "signerAddress": "",
        "error": {
          "code": "ACCOUNT_MISMATCH",
          "message": "The requested account is not active."
        }
      }
    },
    {
      "id": "lifecycle-sign-message-empty-input",
      "title": "signMessage rejects whitespace-only message with INVALID_INPUT",
      "category": "error-validation",
      "provenance": {
        "generator": "@stellar/stellar-sdk StrKey public-byte encoding",
        "containsSecretMaterial": false,
        "identitiesUsed": ["account-zero-default"],
        "deterministicConstruction": "Whitespace message '   ' fails non-empty input validation."
      },
      "initialState": {
        "installed": true,
        "connected": true,
        "allowed": true,
        "address": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF",
        "network": "TESTNET",
        "networkPassphrase": "Test SDF Network ; September 2015"
      },
      "request": {
        "operation": "signMessage",
        "args": ["   "]
      },
      "expectedResult": {
        "signedMessage": "",
        "signerAddress": "",
        "error": {
          "code": "INVALID_INPUT",
          "message": "Message must not be empty."
        }
      }
