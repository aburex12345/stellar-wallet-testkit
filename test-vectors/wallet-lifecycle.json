  "suite": "wallet-lifecycle",
  "description": "Deterministic wallet connection, permission, network inspection, message signing, and structured error object-result fixtures.",
  "vectors": [
    {
      "id": "lifecycle-is-connected-true",
      "title": "Connected and installed wallet reports isConnected=true",
      "category": "connection",
      "provenance": {
        "generator": "@stellar/stellar-sdk StrKey public-byte encoding",
        "containsSecretMaterial": false,
        "identitiesUsed": ["account-zero-default"],
        "deterministicConstruction": "Default wallet state with 32 zero public bytes encoded as Ed25519 StrKey."
      },
      "initialState": {
        "installed": true,
        "connected": true,
        "allowed": true,
        "address": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF",
        "network": "TESTNET",
        "networkPassphrase": "Test SDF Network ; September 2015"
      },
      "request": {
        "operation": "isConnected",
        "args": []
      },
      "expectedResult": {
        "isConnected": true
      }
    },
    {
