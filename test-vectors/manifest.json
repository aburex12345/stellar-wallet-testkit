  "suites": [
    {
      "suite": "wallet-lifecycle",
      "path": "./wallet-lifecycle.json",
      "vectorCount": 10,
      "summary": "Deterministic wallet connection, permission, network inspection, message signing, and structured error object-result fixtures."
    },
    {
      "suite": "transactions",
      "path": "./transactions.json",
      "vectorCount": 6,
